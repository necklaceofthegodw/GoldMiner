# URL prefix of the game behind the reverse proxy (all pages, assets and /api routes live under it).
# Use / to serve at the root. Changing it requires a rebuild (delete dist; start.bat rebuilds).
BASE_PATH=/game/goldminer
# false: the proxy forwards the path unchanged (/game/goldminer/x -> backend /game/goldminer/x).
# true:  the proxy strips the prefix (/game/goldminer/x -> backend /x). No rebuild needed, just restart.
BASE_PATH_STRIPPED=false

# Backend configuration, matching BatyskafWeb. Never prefix arm keys with VITE_.
ARM_ALICE_URL=http://157.158.83.183:8001/api/v1/data
ARM_ALICE_API_KEY=
ARM_BOB_URL=http://157.158.83.183:8002/api/v1/data
ARM_BOB_API_KEY=

# Server-only token for globally unique Miner1, Miner2, ... names.
BLOB_READ_WRITE_TOKEN=
