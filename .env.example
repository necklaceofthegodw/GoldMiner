# Backend configuration, matching BatyskafWeb. Never prefix arm secrets with VITE_.
# API keys are optional; leave empty for the current Alice/Bob endpoints.
ARM_ALICE_URL=http://157.158.83.183:8001/api/v1/data
ARM_ALICE_API_KEY=
ARM_BOB_URL=http://157.158.83.183:8002/api/v1/data
ARM_BOB_API_KEY=

# Public defaults only. Portal launch parameters override these values.
VITE_GOLDMINER_CHOICE_URL=
# Select alice or bob here, or supply ChoiceArm in the portal launch URL.
# Leave unset when the portal selects the arm for each participant.
VITE_GOLDMINER_ARM=
VITE_GOLDMINER_GAME_ID=goldminer
# Prefer a per-participant ChoicePlayerId supplied by the portal.
VITE_GOLDMINER_PLAYER_ID=
# Never put the API key in VITE_* variables: they are embedded in the bundle.

# Server-only token for globally unique Miner1, Miner2, ... names.
# Use the same private Blob store for all deployments sharing the sequence.
BLOB_READ_WRITE_TOKEN=
